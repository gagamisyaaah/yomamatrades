//@version=5
indicator("DRAGON TREE — runner in trends, washout in downtrends", "DRAGON TREE", overlay=true, max_labels_count=200)
// One indicator, two lanes, handed over by the name's own regime:
//   NOT in a long downtrend → RUNNER: the volatility hole breaks up → hold until it breaks down (green triangles / red triangles)
//   IN a long downtrend     → WASHOUT (SUPER STRUCTURE): path dominated by drawdown, close at the day's low, at the last swing
//                             low, near the 50-bar low → +2 / −4 ATR bracket over 20 bars (blue diamonds)
// Regime = 21-day SMA more than `downPct` below the 200-day SMA. Evidence (matrix, 2024+ holdout): the runner's gain over an
// in-force entry is +1.8 % outside that state and ≈ 0 inside it; the washout is +0.35 ATR outside and ≈ flat inside (strong
// in-sample). The RUNNER lane pays on volatile names ($500M–5B, ATR ≥ 5 %); read the table before taking anything.

holeK   = input.float(1.4, "Hole k·ATR", step=0.1)
pivL    = input.int(4, "Hole pivot strength", minval=1)
downPct = input.float(5.0, "Long downtrend: 21-SMA below 200-SMA by ≥ %", step=0.5)
atrMin  = input.float(5.0, "RUNNER universe: ATR % of price ≥", step=0.5)
volMin  = input.float(1.5, "Volume on the break ≥ x× 20-day (readout)", step=0.25)
wAsym   = input.float(-0.874, "Washout: path asymmetry ≤", step=0.05)
wClv    = input.float(0.08271, "Washout: close position in range ≤", step=0.01)
wDpl    = input.float(0.7581, "Washout: distance to last swing low (ATR) ≤", step=0.05)
wLo50   = input.float(105.7, "Washout: close vs 50-bar low (%) ≤", step=0.5)

atrV = ta.atr(14)
downtrend = ta.sma(close, 21) < ta.sma(close, 200) * (1 - downPct / 100)

// ── RUNNER: the volatility hole ──
maV = ta.sma(close, 10)
ph = ta.pivothigh(high, pivL, pivL)
pl = ta.pivotlow(low, pivL, pivL)
var float hUp = na
var float hDn = na
var int hState = 0
var float breakVol = na
var int breakBar = na
var float pl_px = na
if not na(pl)
    pl_px := pl
if not na(ph) or not na(pl)
    hUp := maV[pivL] + holeK * atrV[pivL]
    hDn := maV[pivL] - holeK * atrV[pivL]
    hState := 0
brokeUp = false
brokeDn = false
if hState == 0 and not na(hUp)
    if close > hUp and close[1] > hUp
        hState := 1
        brokeUp := true
        breakBar := bar_index
        breakVol := math.max(volume, volume[1]) / ta.sma(volume, 20)
    else if close < hDn and close[1] < hDn
        hState := -1
        brokeDn := true
runnerEnter = brokeUp and not downtrend
runnerExit = brokeDn

// ── WASHOUT (SUPER STRUCTURE) ──
float drawup20 = 0.0
float drawdown20 = 0.0
float runmin20 = na
float runmax20 = na
for i = 19 to 0
    c_ = close[i]
    runmin20 := na(runmin20) ? c_ : math.min(runmin20, c_)
    runmax20 := na(runmax20) ? c_ : math.max(runmax20, c_)
    drawup20 := math.max(drawup20, c_ / runmin20 - 1)
    drawdown20 := math.max(drawdown20, 1 - c_ / runmax20)
asym20 = math.log((drawup20 + 0.01) / (drawdown20 + 0.01))
clv = (close - low) / (high - low)
d_pl = (close - pl_px) / atrV
lo50 = close / ta.lowest(low, 50) * 100
washOn = asym20 <= wAsym and clv <= wClv and d_pl <= wDpl and lo50 <= wLo50
washEnter = washOn and not washOn[1] and downtrend

// ── readouts ──
atrPct = atrV / close * 100
dvolM = ta.sma(close * volume, 20) / 1e6
inUni = atrPct >= atrMin

plot(hUp, "Hole upper", color=color.new(color.orange, 30), style=plot.style_linebr)
plot(hDn, "Hole lower", color=color.new(color.orange, 30), style=plot.style_linebr)
bgcolor(downtrend ? color.new(color.blue, 94) : hState == 1 ? color.new(color.lime, 94) : na)
plotshape(runnerEnter, "RUNNER enter", style=shape.triangleup, location=location.belowbar, color=inUni ? color.new(color.lime, 0) : color.new(color.gray, 20), size=size.small)
plotshape(runnerExit, "RUNNER exit", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
plotshape(washEnter, "WASHOUT enter (bracket +2/−4 ATR, 20 bars)", style=shape.diamond, location=location.belowbar, color=color.new(color.aqua, 0), size=size.small)
if washEnter
    label.new(bar_index, low, "washout · target " + str.tostring(close + 2 * atrV, "#.##") + " · stop " + str.tostring(close - 4 * atrV, "#.##"), style=label.style_label_up, color=color.new(color.aqua, 30), textcolor=color.black, size=size.small)
if runnerEnter
    label.new(bar_index, low, "runner · vol " + str.tostring(breakVol, "#.##") + "× · ATR " + str.tostring(atrPct, "#.#") + "%", style=label.style_label_up, color=breakVol >= volMin and inUni ? color.new(color.lime, 20) : color.new(color.gray, 40), textcolor=color.black, size=size.small)

var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "regime", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(t, 1, 0, downtrend ? "LONG DOWNTREND · washout lane" : "trend / neutral · runner lane", text_color=color.white, bgcolor=downtrend ? color.new(color.blue, 20) : color.new(color.green, 20))
    table.cell(t, 0, 1, "hole", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(t, 1, 1, hState == 1 ? "UP · hold" : hState == -1 ? "DOWN · out" : "in force", text_color=color.white, bgcolor=hState == 1 ? color.new(color.green, 20) : hState == -1 ? color.new(color.red, 20) : color.new(color.gray, 20))
    table.cell(t, 0, 2, "ATR % · $M/day", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(t, 1, 2, str.tostring(atrPct, "#.#") + "% · $" + str.tostring(dvolM, "#.#") + "M", text_color=color.white, bgcolor=inUni ? color.new(color.green, 20) : color.new(color.red, 20))
    table.cell(t, 0, 3, "volume on the break", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(t, 1, 3, na(breakVol) ? "—" : str.tostring(breakVol, "#.##") + "× 20d", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(t, 0, 4, "washout blocks", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(t, 1, 4, "asym " + str.tostring(asym20, "#.##") + " · clv " + str.tostring(clv, "#.##") + " · d_pl " + str.tostring(d_pl, "#.##") + " · lo50 " + str.tostring(lo50, "#.#"), text_color=color.white, bgcolor=washOn ? color.new(color.aqua, 40) : color.new(color.black, 20))

alertcondition(runnerEnter, "TREE runner enter", "{{ticker}}: hole broke UP in a trend — runner entry next open")
alertcondition(runnerExit, "TREE runner exit", "{{ticker}}: hole broke DOWN — exit")
alertcondition(washEnter, "TREE washout enter", "{{ticker}}: washout in a downtrend — bracket +2/−4 ATR")
