//@version=5
// ─────────────────────────────────────────────────────────────────────────────
//  Startup.io-style · MOUNTAIN (0–4 columns) — "validates the diamonds"
//  Was called FLOW in V7 ("the whale tracker… what we called whale accumulation… purple is retail and you
//  don't want that… if it's maxed out at the max threshold, that's a very good sign to enter anything").
//  Official reading (Sun Liao, Mountain Trading Guide):
//    no columns = lots of bears · purple = some bulls, mostly bears · grey = roughly equal ·
//    green = lots of bulls; "prices continue up until green columns turn grey again".
//  Clone: count of 4 bullish conditions → 0 (none), 1 (purple), 2 (grey), 3–4 (green). Startup.io's own
//  whale/retail volume classifier is private; this stand-in reproduces the staircase and colour semantics.
//    1  hype wave (volume momentum) > 0
//    2  money flow (MFI − 50) > 0
//    3  close above the gold band (EMA 21/34/55)
//    4  gold band rising (EMA21 > EMA55 and EMA21 rising)
// ─────────────────────────────────────────────────────────────────────────────
indicator("Startup.io-style · Mountain", "SU Mountain", overlay=false, precision=0)

hLen = input.int(10, "Hype wave length", minval=2)
hSm  = input.int(3,  "Hype wave smoothing", minval=1)
mLen = input.int(14, "Money-flow length", minval=2)
mSm  = input.int(3,  "Money-flow smoothing", minval=1)
g1 = input.int(21, "Gold EMA 1", minval=1)
g2 = input.int(34, "Gold EMA 2", minval=1)
g3 = input.int(55, "Gold EMA 3", minval=1)
cBear = input.color(#6f5cf0, "1 — purple (mostly bears)")
cMid  = input.color(#8c8c8c, "2 — grey (balanced)")
cBull = input.color(#1fbf8f, "3–4 — green (bulls)")

signedVol = close > close[1] ? volume : close < close[1] ? -volume : 0.0
volE = ta.ema(volume, hLen)
svE  = ta.ema(signedVol, hLen)
hype = ta.ema((volE > 0 ? 100.0 * svE / volE : 0.0) / 2.0, hSm)
flow = ta.ema(ta.mfi(hlc3, mLen) - 50.0, mSm)
e1 = ta.ema(close, g1)
e2 = ta.ema(close, g2)
e3 = ta.ema(close, g3)
goldTop = math.max(e1, math.max(e2, e3))

c1 = hype > 0
c2 = flow > 0
c3 = close > goldTop
c4 = e1 > e3 and e1 > e1[1]
score = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0)
col = score >= 3 ? cBull : score == 2 ? cMid : cBear

plot(score, "Mountain", color=color.new(col, 20), style=plot.style_area)
plot(score, "Mountain edge", color=col, linewidth=2)
hline(4.0, "4", color=color.new(color.white, 80))
hline(2.0, "2", color=color.new(color.white, 80), linestyle=hline.style_dotted)
hline(0.0, "0", color=color.new(color.white, 80))

alertcondition(score >= 3 and score[1] < 3, "SU Mountain → GREEN", "Mountain turned green (lots of bulls)")
alertcondition(score < 3 and score[1] >= 3, "SU Mountain green → grey/purple", "Mountain left green (trend may be ending)")
alertcondition(score == 0 and score[1] > 0, "SU Mountain → no columns", "Mountain collapsed to zero (lots of bears)")
