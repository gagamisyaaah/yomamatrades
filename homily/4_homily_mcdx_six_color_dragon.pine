//@version=5
// ─────────────────────────────────────────────────────────────────────────────
//  Homily Chart · MCDX — Multicolor Dragon X (六彩神龙 "Six-Color Dragon")
//  Homily's own description: three chip groups that always sum to 100 —
//    PCHIPS (red)    = Profit chips   — cost below price·(1−band)  → Danny's "whales"
//    FCHIPS (yellow) = Floating chips — cost within ±band of price → Danny's "day traders"
//    LCHIPS (green)  = Locked chips   — cost above price·(1+band) → Danny's "retail"
//  plus a smoother moving-average line per group (the "(8)" in the Homily header).
//  Leaked 通达信 imitation: WINNER(close·0.9) / WINNER(close·1.1) on the cost distribution, MA-smoothed.
//  This port builds a real rolling cost distribution (volume at price over `winN` bars, no decay).
//  NOT the RSI-based "MCDX" clones circulating on TradingView — those cannot sum to 100.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Homily MCDX — Six-Color Dragon (六彩神龙)", "Homily MCDX", overlay=false, precision=3)

max_bars_back(high, 700)
max_bars_back(low, 700)
max_bars_back(volume, 700)

gM      = "MCDX"
winN    = input.int(120, "Cost-distribution window (bars)", minval=10, maxval=600, group=gM)
band    = input.float(4.0, "Floating band ± % (Homily clones use 4 or 10)", minval=0.5, step=0.5, group=gM)
refO    = input.string("close", "Reference price", options=["close", "ohlc4"], group=gM)
barLen  = input.int(3, "Bar smoothing (SMA)", minval=1, group=gM)
lineLen = input.int(8, "Line smoothing (SMA) — Homily's '(8)'", minval=1, group=gM)
binPct  = input.float(0.25, "Price bin (%)", minval=0.05, step=0.05, group=gM)
cP  = input.color(#ff2a2a, "Profit chips (red = whales)", group=gM)
cF  = input.color(#ffd400, "Floating chips (yellow = day traders)", group=gM)
cL  = input.color(#22e022, "Locked chips (green = retail)", group=gM)
cPl = input.color(#b04cff, "Profit MA line (purple)", group=gM)
cFl = input.color(#ff4cd8, "Floating MA line (magenta)", group=gM)
cLl = input.color(#2fe8ff, "Locked MA line (cyan)", group=gM)

// ═══════════════ rolling cost distribution (log-spaced bins, add new bar / remove leaving bar) ═══════════════
lnStep = math.log(1.0 + binPct / 100.0)
binOf(float p) => int(math.floor(math.log(p) / lnStep))

var float[] chips = array.new_float()
var int[]   loA   = array.new_int(1, 0)

ensure(int bL, int bH) =>
    if array.size(chips) == 0
        array.set(loA, 0, bL)
        for b = bL to bH
            array.push(chips, 0.0)
    else
        while bL < array.get(loA, 0)
            array.unshift(chips, 0.0)
            array.set(loA, 0, array.get(loA, 0) - 1)
        while bH > array.get(loA, 0) + array.size(chips) - 1
            array.push(chips, 0.0)
    true

addRange(int bL, int bH, float v) =>
    per = v / float(bH - bL + 1)
    l0  = array.get(loA, 0)
    for b = bL to bH
        array.set(chips, b - l0, array.get(chips, b - l0) + per)
    true

if nz(volume) > 0 and low > 0 and high >= low
    bL = binOf(low)
    bH = binOf(high)
    ensure(bL, bH)
    addRange(bL, bH, volume)
if bar_index >= winN and nz(volume[winN]) > 0 and low[winN] > 0 and high[winN] >= low[winN]
    addRange(binOf(low[winN]), binOf(high[winN]), -nz(volume[winN]))

ref = refO == "ohlc4" ? ohlc4 : close
loT = ref * (1.0 - band / 100.0)
hiT = ref * (1.0 + band / 100.0)

float tot     = 0.0
float belowLo = 0.0
float belowHi = 0.0
sz = array.size(chips)
if sz > 0
    l0 = array.get(loA, 0)
    for i = 0 to sz - 1
        v = math.max(0.0, array.get(chips, i))
        if v > 0
            pr = math.exp((l0 + i + 0.5) * lnStep)
            tot += v
            if pr < loT
                belowLo += v
            if pr < hiT
                belowHi += v

rawP = tot > 0 ? belowLo / tot * 100.0 : na
rawL = tot > 0 ? (tot - belowHi) / tot * 100.0 : na
rawF = tot > 0 ? 100.0 - rawP - rawL : na

P  = ta.sma(rawP, barLen)
L  = ta.sma(rawL, barLen)
F  = ta.sma(rawF, barLen)
Pl = ta.sma(rawP, lineLen)
Ll = ta.sma(rawL, lineLen)
Fl = ta.sma(rawF, lineLen)

// stacked 100 % columns: draw green (100), then yellow (P+F), then red (P) on top
plot(100.0,  "LCHIPS locked (green)",    color=cL, style=plot.style_columns)
plot(P + F,  "FCHIPS floating (yellow)", color=cF, style=plot.style_columns)
plot(P,      "PCHIPS profit (red)",      color=cP, style=plot.style_columns)
plot(Pl, "PCHIPS MA line", color=cPl, linewidth=2)
plot(Ll, "LCHIPS MA line", color=cLl, linewidth=2)
plot(Fl, "FCHIPS MA line", color=cFl, linewidth=2)
hline(50.0, "Run threshold (whales ≥ 50)",   color=color.new(color.white, 40), linestyle=hline.style_dashed)
hline(75.0, "Surge threshold (whales ≥ 75)", color=color.new(color.white, 40), linestyle=hline.style_dotted)
hline(25.0, "Retail warning (retail ≥ 25)",  color=color.new(color.white, 70), linestyle=hline.style_dotted)

// leaked-formula extra: whales dropped > 30 % from their 15-bar high (shake-out / distribution flag)
hhP  = ta.highest(P, 15)
shk  = not na(rawP) and rawP > 0 and (hhP - rawP) / rawP * 100.0 > 30.0 and hhP > 50.0
plotshape(shk, "Whale drop >30% from 15-bar high", shape.square, location.bottom, color.new(#4c7dff, 0), size=size.tiny)

var table tb = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 35), border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "PCHIPS " + str.tostring(P, "#.###") + " (" + str.tostring(Pl, "#.###") + ")   FCHIPS " + str.tostring(F, "#.###") + " (" + str.tostring(Fl, "#.###") + ")   LCHIPS " + str.tostring(L, "#.###") + " (" + str.tostring(Ll, "#.###") + ")", text_color=color.white, text_size=size.small)

alertcondition(ta.crossover(P, 50.0),  "Homily MCDX: whales cross 50", "Whales (profit chips) crossed above 50 — stock can run")
alertcondition(ta.crossover(P, 75.0),  "Homily MCDX: whales cross 75", "Whales (profit chips) crossed above 75 — surge zone")
alertcondition(ta.crossunder(L, 10.0), "Homily MCDX: retail < 10",     "Retail (locked chips) fell below 10 — green bars disappearing")
alertcondition(shk and not shk[1],     "Homily MCDX: whale shake-out", "Whales dropped >30 % from 15-bar high")
