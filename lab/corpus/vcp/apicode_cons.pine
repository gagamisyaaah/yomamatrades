//@version=6
indicator("Consolidation zones + Breakout", overlay = true)
//----------------------
// Parámetros
//----------------------
lookback  = input.int(10,  "Candles for range",        minval = 5)
minBars   = input.int(8,   "Min. candles in consolidation", minval = 3)
atrLen    = input.int(14,  "ATR Lenght",           minval = 5)
atrMult   = input.float(2.7, "Max range in multiples of ATR", step = 0.1)

//----------------------
// Cálculo de rango y ATR
//----------------------
rangeHigh = ta.highest(high, lookback)
rangeLow  = ta.lowest(low,  lookback)
rng       = rangeHigh - rangeLow
atrVal    = ta.atr(atrLen)

// Condición base de consolidación (rango comprimido)
baseConso = rng < atrVal * atrMult

// Mínimo número de velas seguidas en rango
isConsolidating = ta.barssince(not baseConso) >= minBars

// Detectar comienzo de una nueva zona (cambio de false a true)
newZone = isConsolidating and not isConsolidating[1]

//----------------------
// Pintar zona en amarillo
//----------------------
pHigh = plot(rangeHigh, display = display.none)
pLow  = plot(rangeLow,  display = display.none)
fillColor = isConsolidating ? color.new(#ffeb3b, 80) : color.new(#ffeb3b, 100)
fill(pHigh, pLow, color = fillColor, title = "Consolidation Zone")

//----------------------
// Detección de breakouts
//----------------------
// Cuando venimos de consolidación y salimos de la zona:
// - Long: cierre rompe por encima del rangoHigh
// - Short: cierre rompe por debajo del rangoLow
wasConso = isConsolidating[1]
breakLong  = not isConsolidating and wasConso and close > rangeHigh[1]
breakShort = not isConsolidating and wasConso and close < rangeLow[1]

//----------------------
// Labels en el inicio del long/short
//----------------------
if breakLong
    label.new(bar_index, low, "LONG",
        style = label.style_label_up,
        textcolor = color.white,
        color = color.new(color.teal, 0),
        size = size.tiny)

if breakShort
    label.new(bar_index, high, "SHORT",
        style = label.style_label_down,
        textcolor = color.white,
        color = color.new(color.red, 0),
        size = size.tiny)

