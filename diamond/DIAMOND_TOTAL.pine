//@version=5
// DIAMOND TOTAL — the four Diamond (Startup.io) panels read together as ONE signal, in one indicator.
// Panels: Bravo (price vs the gold band, diamonds on the candles) · Echo (hype wave diamonds) · Tango (money-flow
// diamonds) · Mountain (0–4) · plus Voila levels (gold band, purple pivot resistance) and the Bubble meter.
// A diamond only COUNTS once it is confirmed (its bar's high closes over within 3 bars), else it is invalidated.
// Readings (input "Entry") — long-only, entry at the NEXT open:
//   "Strict"  = 3 confirmed blue diamonds + Mountain 4 + close above gold + Bubble not overheated  ← DEFAULT
//               Calibration sweep (54 settings, 94 tickers, out-of-sample 2024+, flip exit, random entries = +3.0 %):
//               confirmation window 5 bars → +8.9 % avg per trade, PF 2.7, ~2.8 signals/week (402 trades; the robust
//               pick, now the default); window 2 + strict Mountain → +10.5–11.2 %, PF > 3, but ~1.2/week.
//               Wave travel 10 keeps the diamonds on the founders' own bars (IREN, SLNH, ONDS anchors) — do not lower it.
//   "2 of 3"  = 2 confirmed blue + Mountain ≥ 3 + above gold — ~3.4 % per trade, barely above random; kept for reference
//   "Mountain maxed + above gold"
// Exit: "Flip" = 2 pink confirmed OR Mountain ≤ 2 OR a close below the gold band · "Flip or overheated" (also
//   > 2 ATR above gold while bubble > 8.7) · "Chandelier 3 ATR".  Alerts: DIAMOND go / out / armed.
indicator("DIAMOND TOTAL", "DIAMOND", overlay=true, max_labels_count=100)

entryMode = input.string("Strict", "Entry", options=["Strict", "2 of 3", "Mountain maxed + above gold"])
exitMode  = input.string("Flip", "Exit", options=["Flip", "Flip or overheated", "Chandelier 3 ATR"])
minMove = input.float(10.0, "Min wave travel between diamonds (10 = founders' bars)", minval=0)
confirmBars = input.int(5, "Diamond confirmation window (bars to close through the diamond bar)", minval=1, maxval=10)
mtnStrict = input.bool(false, "Strict Mountain (hype & flow > 10, maxed only if it persisted 3 bars) — fewer, bigger trades")
showTbl = input.bool(true, "Panel table")

atr14 = ta.atr(14)
signedVol = close > close[1] ? volume : close < close[1] ? -volume : 0.0
volE = ta.ema(volume, 10)
svE = ta.ema(signedVol, 10)
hype = ta.ema((volE > 0 ? 100.0 * svE / volE : 0.0) / 2.0, 3)
hypeSig = ta.ema(hype, 5)
flow = ta.ema(ta.mfi(hlc3, 14) - 50.0, 3)
flowSig = ta.ema(flow, 5)
e1 = ta.ema(close, 21)
e2 = ta.ema(close, 34)
e3 = ta.ema(close, 55)
goldTop = math.max(e1, math.max(e2, e3))
goldBot = math.min(e1, math.min(e2, e3))

diamondEngine(float w, float s) =>
    var float hi = na
    var float lo = na
    hi := na(hi) ? w : math.max(hi, w)
    lo := na(lo) ? w : math.min(lo, w)
    travel = hi - lo
    up = ta.crossover(w, s) and travel >= minMove
    dn = ta.crossunder(w, s) and travel >= minMove
    if up or dn
        hi := w
        lo := w
    [up, dn]
[echoBlue, echoPink] = diamondEngine(hype, hypeSig)
[tangoBlue, tangoPink] = diamondEngine(flow, flowSig)
bravoBlue = ta.crossover(close, goldTop) and hype > hypeSig
bravoPink = ta.crossunder(close, goldBot) and hype < hypeSig

confirmed(bool b, bool p) =>
    var int st = 0
    var float lvl = na
    var int since = 0
    var bool ok = false
    if b or p
        st := b ? 1 : -1
        lvl := b ? high : low
        since := 0
        ok := false
    else
        since += 1
    if st == 1 and not ok and close > lvl
        ok := true
    if st == -1 and not ok and close < lvl
        ok := true
    if not ok and since > confirmBars
        st := 0
    ok ? st : 0
cB = confirmed(bravoBlue, bravoPink)
cE = confirmed(echoBlue, echoPink)
cT = confirmed(tangoBlue, tangoPink)
nBlueC = (cB == 1 ? 1 : 0) + (cE == 1 ? 1 : 0) + (cT == 1 ? 1 : 0)
nPinkC = (cB == -1 ? 1 : 0) + (cE == -1 ? 1 : 0) + (cT == -1 ? 1 : 0)
bandUp = e1 > e3 and e1 > e1[1]
mtnA = (hype > 0 ? 1 : 0) + (flow > 0 ? 1 : 0) + (close > goldTop ? 1 : 0) + (bandUp ? 1 : 0)
mtnB = (hype > 10 ? 1 : 0) + (flow > 10 ? 1 : 0) + (close > goldTop ? 1 : 0) + (bandUp ? 1 : 0)
mtnPersist = mtnB >= 2 and mtnB[1] >= 2 and mtnB[2] >= 2
mountain = mtnStrict ? (mtnB == 4 and not mtnPersist ? 3 : mtnB) : mtnA

phD = ta.pivothigh(high, 5, 5)
var float purple = na
if not na(phD)
    purple := phD
if not na(purple) and close > purple
    purple := na
weakRes = na(purple) or purple - close > 2.0 * atr14
bubble = math.max(0.0, (close - ta.ema(close, 200)) / atr14) + (hype > 25 ? 1.0 : 0.0) + (flow > 25 ? 1.0 : 0.0)
bubbleHot = (timeframe.isdaily or timeframe.isweekly) and bubble >= 6.0
overheated = (close - goldTop) / atr14 > 2.0 and bubble > 8.7

stateOn = entryMode == "Strict" ? (nBlueC == 3 and mountain == 4 and close > goldTop and not bubbleHot) : entryMode == "2 of 3" ? (nBlueC >= 2 and mountain >= 3 and close > goldTop) : (mountain == 4 and close > goldTop)
flipOff = entryMode == "Mountain maxed + above gold" ? mountain <= 2 : (nPinkC >= 2 or mountain <= 2 or close < goldBot)

hh22 = ta.highest(high, 22)
var bool inPos = false
var float trail = na
goNow = stateOn and not stateOn[1] and not inPos
if goNow
    inPos := true
    trail := hh22 - 3.0 * atr14
else if inPos
    trail := math.max(nz(trail, 0.0), hh22 - 3.0 * atr14)
outNow = inPos and not goNow and (exitMode == "Flip" ? flipOff : exitMode == "Flip or overheated" ? (flipOff or overheated) : close < trail)
if outNow
    inPos := false
    trail := na

p1 = plot(goldTop, "Gold top", color=color.new(#c9a227, 0))
p2 = plot(goldBot, "Gold bottom", color=color.new(#c9a227, 0))
fill(p1, p2, color=color.new(#c9a227, 85), title="Gold band")
plot(purple, "Purple resistance", color=color.new(color.purple, 0), style=plot.style_cross)
bgcolor(stateOn ? color.new(color.blue, 90) : na, title="Reading ON")
plotshape(cE == 1 and cE[1] != 1, "Echo confirmed", shape.diamond, location.belowbar, color=color.new(color.aqua, 0), size=size.tiny)
plotshape(cT == 1 and cT[1] != 1, "Tango confirmed", shape.diamond, location.belowbar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(cB == 1 and cB[1] != 1, "Bravo confirmed", shape.diamond, location.belowbar, color=color.new(color.navy, 0), size=size.tiny)
plotshape(nPinkC >= 2 and nPinkC[1] < 2, "2 pink confirmed", shape.diamond, location.abovebar, color=color.new(#ff4fa3, 0), size=size.tiny)
plotshape(goNow, "DIAMOND go", shape.labelup, location.belowbar, color=color.new(color.blue, 0), text="GO", textcolor=color.white, size=size.small)
plotshape(outNow, "DIAMOND out", shape.xcross, location.abovebar, color=color.new(color.gray, 0), size=size.small)
plot(inPos and exitMode == "Chandelier 3 ATR" ? trail : na, "Chandelier", color=color.new(color.orange, 0), style=plot.style_circles)

alertcondition(goNow, "DIAMOND go", "{{ticker}} {{interval}}: DIAMOND total signal ON — enter next open")
alertcondition(outNow, "DIAMOND out", "{{ticker}} {{interval}}: DIAMOND exit")
alertcondition(nBlueC >= 2 and nBlueC[1] < 2, "DIAMOND armed", "{{ticker}} {{interval}}: 2 confirmed blue diamonds")

var table tbl = table.new(position.top_right, 2, 8, border_width=1)
cell(int r, string k, string v, bool good) =>
    table.cell(tbl, 0, r, k, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small)
    table.cell(tbl, 1, r, v, text_color=color.white, bgcolor=good ? color.new(color.blue, 20) : color.new(color.gray, 60), text_size=size.small)
if showTbl and barstate.islast
    cell(0, "DIAMOND", stateOn ? "ON" : "off", stateOn)
    cell(1, "Blue confirmed", str.tostring(nBlueC) + " / 3", nBlueC >= 2)
    cell(2, "Pink confirmed", str.tostring(nPinkC) + " / 3", nPinkC == 0)
    cell(3, "Mountain", str.tostring(mountain) + " / 4", mountain >= 3)
    cell(4, "Gold band", close > goldTop ? "above" : close < goldBot ? "below" : "inside", close > goldTop)
    cell(5, "Purple resistance", na(purple) ? "none" : str.tostring((purple - close) / atr14, "#.#") + " ATR above", weakRes)
    cell(6, "Bubble", str.tostring(bubble, "#.#") + (bubbleHot ? " HOT" : ""), not bubbleHot)
    cell(7, "Heat (2 ATR>gold & bubble>8.7)", overheated ? "OVERHEATED" : "ok", not overheated)
